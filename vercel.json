{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist"
      }
    }
  ],
  "routes": [
    { "src": "/auth/(.*)", "dest": "/api/index.js" },
    { "src": "/auth", "dest": "/api/index.js" },
    { "src": "/properties/(.*)", "dest": "/api/index.js" },
    { "src": "/properties", "dest": "/api/index.js" },
    { "src": "/users/(.*)", "dest": "/api/index.js" },
    { "src": "/users", "dest": "/api/index.js" },
    { "src": "/messages/(.*)", "dest": "/api/index.js" },
    { "src": "/messages", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/api/index.js" },
    { "src": "/admin", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
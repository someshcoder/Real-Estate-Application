{
  "version": 2,
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  },
  "outputDirectory": "client/dist",
  "routes": [
    { "src": "/auth/(.*)", "dest": "/api/index.js" },
    { "src": "/auth", "dest": "/api/index.js" },
    { "src": "/properties/(.*)", "dest": "/api/index.js" },
    { "src": "/properties", "dest": "/api/index.js" },
    { "src": "/users/(.*)", "dest": "/api/index.js" },
    { "src": "/users", "dest": "/api/index.js" },
    { "src": "/messages/(.*)", "dest": "/api/index.js" },
    { "src": "/messages", "dest": "/api/index.js" },
    { "src": "/admin/(.*)", "dest": "/api/index.js" },
    { "src": "/admin", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}